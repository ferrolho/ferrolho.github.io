---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { TOPICS } from '../content.config';
import Icon from './Icon.astro';
import { projectYears, formatStars } from '../lib/format';

interface Props {
  project: CollectionEntry<'projects'>;
  size?: 'lg' | 'md';
  eager?: boolean;
}

const { project, size = 'md', eager = false } = Astro.props;
const d = project.data;
const href = `/projects/${project.id}/`;
const primary = d.topics[0];
---

<article
  class:list={['card', size, { 'has-preview': d.preview }]}
  data-topics={d.topics.join(' ')}
  data-year={d.date.getFullYear()}
>
  <a href={href} class="card-link">
    <div class="media" style={`view-transition-name: project-${project.id.replace(/[^\w-]/g, '-')}`}>
      <Image
        src={d.cover}
        alt={d.coverAlt}
        widths={size === 'lg' ? [640, 960, 1400] : [480, 720, 960]}
        sizes={size === 'lg'
          ? '(max-width: 760px) 100vw, (max-width: 1240px) 66vw, 820px'
          : '(max-width: 760px) 100vw, (max-width: 1240px) 50vw, 400px'}
        loading={eager ? 'eager' : 'lazy'}
        style={`object-position: ${d.coverPosition}; object-fit: ${d.coverFit}`}
      />
      {
        d.preview && (
          <video class="preview" muted loop playsinline preload="none" data-src={d.preview} aria-hidden="true" />
        )
      }
      <span class="bbox" aria-hidden="true">
        <i></i><i></i><i></i><i></i>
        <span class="label">{TOPICS[primary].toLowerCase()}</span>
      </span>
      {d.draft && <span class="draft">Draft — hidden in production</span>}
    </div>
    <div class="body">
      {size === 'lg' && <span class="featured-tag">Featured</span>}
      <div class="title-row">
        <h3>{d.title}</h3>
        <Icon name="arrow" size={18} class="go" />
      </div>
      <p class="summary">{d.summary}</p>
      <div class="meta">
        <span class="year">{projectYears(d)}</span>
        {d.stack.slice(0, 3).map((s) => <span class="stack">{s}</span>)}
        <span class="grow"></span>
        {
          d.stars !== undefined && d.stars >= 10 && (
            <span class="stat" title="GitHub stars">
              <Icon name="star" size={13} />
              {formatStars(d.stars)}
            </span>
          )
        }
        {
          d.views && (
            <span class="stat" title="YouTube views">
              <Icon name="play" size={12} />
              {d.views}
            </span>
          )
        }
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    position: relative;
    min-width: 0;
  }

  .card[hidden] {
    display: none;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 14px;
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-sunk);
    border: 1px solid var(--line);
    isolation: isolate;
  }

  .media :global(img),
  .preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.3s;
  }

  .preview {
    opacity: 0;
  }

  .card.playing .preview {
    opacity: 1;
  }

  .card-link:hover .media :global(img),
  .card-link:hover .preview {
    transform: scale(1.025);
  }

  /* Bounding box that snaps onto the card on hover. */
  .bbox {
    position: absolute;
    inset: 10px;
    pointer-events: none;
    z-index: 2;
  }

  .bbox i {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: var(--accent);
    border-style: solid;
    border-width: 0;
    opacity: 0;
    transition:
      opacity 0.2s,
      transform 0.35s cubic-bezier(0.2, 0.9, 0.2, 1.2);
  }

  .bbox i:nth-child(1) {
    top: 0;
    left: 0;
    border-top-width: 2px;
    border-left-width: 2px;
    transform: translate(-8px, -8px);
  }
  .bbox i:nth-child(2) {
    top: 0;
    right: 0;
    border-top-width: 2px;
    border-right-width: 2px;
    transform: translate(8px, -8px);
  }
  .bbox i:nth-child(3) {
    bottom: 0;
    left: 0;
    border-bottom-width: 2px;
    border-left-width: 2px;
    transform: translate(-8px, 8px);
  }
  .bbox i:nth-child(4) {
    bottom: 0;
    right: 0;
    border-bottom-width: 2px;
    border-right-width: 2px;
    transform: translate(8px, 8px);
  }

  .label {
    position: absolute;
    top: -1px;
    left: 22px;
    padding: 2px 7px;
    border-radius: 3px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.2s 0.05s,
      transform 0.3s 0.05s;
  }

  .card-link:hover .bbox i,
  .card-link:focus-visible .bbox i {
    opacity: 1;
    transform: none;
  }

  .card-link:hover .label,
  .card-link:focus-visible .label {
    opacity: 1;
    transform: none;
  }

  /* Feature layout: image beside the text. */
  .card.lg .card-link {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
  }

  .card.lg .body {
    gap: 12px;
  }

  .card.lg .summary {
    font-size: 17px;
    -webkit-line-clamp: 4;
    line-clamp: 4;
  }

  .card.lg h3 {
    font-size: clamp(26px, 3vw, 38px);
    letter-spacing: -0.03em;
  }

  .card.lg .featured-tag {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent-ink);
  }

  .card.lg .featured-tag::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (max-width: 860px) {
    .card.lg .card-link {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  .draft {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 2;
    padding: 3px 8px;
    border-radius: 999px;
    background: #111;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-inline: 2px;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  h3 {
    font-size: 19px;
    letter-spacing: -0.015em;
    transition: color 0.15s;
  }

  .lg h3 {
    font-size: clamp(21px, 2.2vw, 26px);
  }

  .title-row :global(.go) {
    flex-shrink: 0;
    color: var(--ink-3);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.2s,
      transform 0.25s,
      color 0.2s;
  }

  .card-link:hover h3 {
    color: var(--accent-ink);
  }

  .card-link:hover :global(.go) {
    opacity: 1;
    transform: none;
    color: var(--accent-ink);
  }

  .summary {
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lg .summary {
    font-size: 16px;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  .year {
    color: var(--ink-2);
  }

  .stack + .stack::before,
  .year + .stack::before {
    content: '/';
    margin-right: 12px;
    color: var(--line-2);
  }

  .grow {
    flex: 1;
  }

  .stat {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--ink-2);
  }

  .stat :global(svg) {
    color: var(--accent);
  }
</style>

<script>
  // Hover (or, on touch screens, scroll into view) to play the preview loop.
  const cards = document.querySelectorAll<HTMLElement>('.card.has-preview');
  const touch = matchMedia('(hover: none)').matches;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function play(card: HTMLElement) {
    const v = card.querySelector<HTMLVideoElement>('video.preview');
    if (!v || reduced) return;
    if (!v.src) v.src = v.dataset.src!;
    v.play()
      .then(() => card.classList.add('playing'))
      .catch(() => {});
  }
  function stop(card: HTMLElement) {
    const v = card.querySelector<HTMLVideoElement>('video.preview');
    card.classList.remove('playing');
    v?.pause();
  }

  if (touch) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => (e.isIntersecting ? play : stop)(e.target as HTMLElement)),
      { threshold: 0.75 },
    );
    cards.forEach((c) => io.observe(c));
  } else {
    cards.forEach((c) => {
      c.addEventListener('mouseenter', () => play(c));
      c.addEventListener('mouseleave', () => stop(c));
      c.addEventListener('focusin', () => play(c));
      c.addEventListener('focusout', () => stop(c));
    });
  }
</script>
