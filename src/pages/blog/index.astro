---
import Page from '../../layouts/Page.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, formatDate } from '../../lib/format';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
---

<Page title="Writing" eyebrow="Writing" index="05" heading="Notes &amp; <em>tutorials</em>" description="Tutorials and notes on robotics, optimisation, Julia, and tools.">
  <Fragment slot="intro">
    Occasional write-ups — build logs, optimisation tutorials, and fixes I wanted to remember. Subscribe via
    <a href="/rss.xml">RSS</a>.
  </Fragment>

  {
    years.map((y) => (
      <section class="year-group">
        <h2 class="year">{y}</h2>
        <ul>
          {posts
            .filter((p) => p.data.date.getFullYear() === y)
            .map((p) => (
              <li>
                <a href={`/blog/${p.id}/`}>
                  <time>{formatDate(p.data.date, { day: 'numeric', month: 'short' })}</time>
                  <span class="t">
                    {p.data.title}
                    {p.data.draft && <span class="draft">draft</span>}
                  </span>
                  <span class="tags">{p.data.tags.join(' · ')}</span>
                  <Icon name="arrow" size={16} />
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</Page>

<style>
  .year-group {
    display: grid;
    grid-template-columns: 120px 1fr;
    border-top: 1px solid var(--ink);
  }

  .year {
    padding-top: 20px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-3);
    letter-spacing: 0;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li + li {
    border-top: 1px solid var(--line);
  }

  a {
    display: grid;
    grid-template-columns: 80px 1fr auto 20px;
    gap: 20px;
    align-items: baseline;
    padding: 20px 8px;
    transition: background 0.15s;
  }

  a:hover {
    background: var(--bg-elev);
  }

  time,
  .tags {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-3);
  }

  .t {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  a:hover .t {
    color: var(--accent-ink);
  }

  .draft {
    margin-left: 8px;
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--accent);
    color: var(--accent-ink);
    font: 400 11px var(--font-mono);
    vertical-align: 3px;
  }

  a :global(svg) {
    align-self: center;
    color: var(--ink-3);
  }

  @media (max-width: 760px) {
    .year-group {
      grid-template-columns: 1fr;
    }
    a {
      grid-template-columns: 1fr 20px;
      gap: 4px 12px;
    }
    time {
      grid-column: 1 / -1;
    }
    .tags {
      display: none;
    }
  }
</style>
